    <!-- About / fork notice -->
    <string name="about_title">关于</string>
    <string name="about_summary">SimpleIMS 是 TurboIMS 的一个分支，可在 Android 12（API 31）及更高版本上运行。</string>
    <string name="about_origin">原始项目：TurboIMS\n作者：Turbo1123（上游）/ vvb2060（机制）\nhttps://github.com/Turbo1123/TurboIMS</string>
    <string name="about_fork_note">本分支保留了原项目的机制和功能范围，新增了对 API 31 的兼容，并附带新的名称、新的图标以及此关于页面。</string>
